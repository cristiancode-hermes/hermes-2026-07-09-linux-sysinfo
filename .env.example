# linux-sysinfo — Environment Configuration
# Copia este archivo como .env y ajusta los valores

# Formato de salida: text (default), json, json-pretty
OUTPUT_FORMAT=json-pretty

# Incluir información de procesos (puede ser lento en sistemas con muchos procesos)
SHOW_PROCESSES=false

# Límite de procesos a mostrar (0 = sin límite)
PROCESS_LIMIT=50
